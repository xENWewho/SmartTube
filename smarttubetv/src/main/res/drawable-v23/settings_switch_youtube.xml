<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: premium settings, checkboxes drawn as switches (YouTube scheme) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="@dimen/settings_switch_width" android:height="@dimen/settings_switch_height">
                <shape android:shape="rectangle">
                    <solid android:color="@color/youtube_red" />
                    <corners android:radius="@dimen/settings_switch_radius" />
                </shape>
            </item>
            <item android:width="@dimen/settings_switch_thumb" android:height="@dimen/settings_switch_thumb"
                android:left="@dimen/settings_switch_thumb_on" android:top="@dimen/settings_switch_thumb_margin">
                <shape android:shape="oval"><solid android:color="@android:color/white" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="@dimen/settings_switch_width" android:height="@dimen/settings_switch_height">
                <shape android:shape="rectangle">
                    <solid android:color="@color/youtube_switch_off" />
                    <corners android:radius="@dimen/settings_switch_radius" />
                </shape>
            </item>
            <item android:width="@dimen/settings_switch_thumb" android:height="@dimen/settings_switch_thumb"
                android:left="@dimen/settings_switch_thumb_margin" android:top="@dimen/settings_switch_thumb_margin">
                <shape android:shape="oval"><solid android:color="@android:color/white" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
