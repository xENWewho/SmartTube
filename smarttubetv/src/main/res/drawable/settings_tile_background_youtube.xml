<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: premium settings tile, solid white rounded tile when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/youtube_focus_ring" />
            <corners android:radius="@dimen/settings_tile_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_tile_youtube" />
            <corners android:radius="@dimen/settings_tile_corner_radius" />
        </shape>
    </item>
</selector>
