<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: premium settings, white rounded bar behind the focused row (YouTube scheme) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetLeft="@dimen/settings_row_bar_inset" android:insetRight="@dimen/settings_row_bar_inset"
            android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/youtube_menu_selected" />
                <corners android:radius="@dimen/settings_row_bar_radius" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
