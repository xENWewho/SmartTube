<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: solid top bar behind the logo and buttons (YouTube scheme).
     Content that scrolls up slides under it; the bottom edge fades out softly. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/youtube_background"
        android:centerColor="@color/youtube_background"
        android:centerY="0.78"
        android:endColor="@color/youtube_background_clear" />
</shape>
