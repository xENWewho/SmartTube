        <item name="settingsRowSummaryColor">@color/lb_preference_item_secondary_text_color</item>
        <item name="settingsCheckButton">?android:attr/listChoiceIndicatorMultiple</item>
        <item name="titleBarBackground">@android:color/transparent</item>
        <item name="premiumTooltipFrame">@drawable/tooltip_frame_dark_mod</item>
        <item name="premiumTooltipTextColor">@color/foreground_material_dark_mod</item>
    </style>
    <style name="App.Theme.Leanback.GuidedStep" parent="Theme.Leanback.GuidedStep">
        <item name="android:windowBackground">@color/shelf_background_dark</item>
        <item name="shelfBackground">@color/shelf_background_dark</item>
        <!-- Disable activity transition animations -->
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Make activity fullscreen -->
        <item name="android:windowFullscreen">true</item>
        <!-- Overlay bottom bar (can't hide it from styles) -->
        <item tools:targetApi="19" name="android:windowTranslucentNavigation">true</item>
        <!-- Settings panel colors (see leanback_preference_fragment.xml) -->
        <item name="settingsPanelBackground">@color/lb_preference_decor_list_background</item>
        <item name="settingsPanelTitleBackground">?attr/defaultBrandColor</item>
        <item name="settingsPanelPadding">0dp</item>
        <item name="settingsRowBackground">?android:attr/selectableItemBackground</item>
        <item name="settingsRowTitleColor">@color/lb_preference_item_primary_text_color</item>
        <item name="settingsRowSummaryColor">@color/lb_preference_item_secondary_text_color</item>
        <item name="settingsCheckButton">?android:attr/listChoiceIndicatorMultiple</item>
        <item name="titleBarBackground">@android:color/transparent</item>
        <item name="premiumTooltipFrame">@drawable/tooltip_frame_dark_mod</item>
        <item name="premiumTooltipTextColor">@color/foreground_material_dark_mod</item>
    </style>
    <!-- AppDialogFragment style -->
    <style name="App.Theme.Leanback.Preferences.Base" parent="Theme.Leanback">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Leanback</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- AppDialogFragment background dimming -->
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/fastlane_background</item>
        <item name="android:colorPrimary" tools:targetApi="21">@color/fastlane_background_dark</item>
        <!-- Disable activity transition animations -->
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Make activity fullscreen -->
        <item name="android:windowFullscreen">true</item>
        <!-- Overlay bottom bar (can't hide it from styles) -->
        <item tools:targetApi="19" name="android:windowTranslucentNavigation">true</item>
        <!-- Settings panel colors (see leanback_preference_fragment.xml) -->
        <item name="settingsPanelBackground">@color/lb_preference_decor_list_background</item>
        <item name="settingsPanelTitleBackground">?attr/defaultBrandColor</item>
        <item name="settingsPanelPadding">0dp</item>
        <item name="settingsRowBackground">?android:attr/selectableItemBackground</item>
        <item name="settingsRowTitleColor">@color/lb_preference_item_primary_text_color</item>
        <item name="settingsRowSummaryColor">@color/lb_preference_item_secondary_text_color</item>
        <item name="settingsCheckButton">?android:attr/listChoiceIndicatorMultiple</item>
        <item name="titleBarBackground">@android:color/transparent</item>
        <item name="premiumTooltipFrame">@drawable/tooltip_frame_dark_mod</item>
        <item name="premiumTooltipTextColor">@color/foreground_material_dark_mod</item>
    </style>
    <!-- Give ability to override style for different api -->
    <style name="App.Theme.Leanback.Preferences" parent="App.Theme.Leanback.Preferences.Base" />
    <!-- Android 8 fallback -->
    <style name="App.Theme.Leanback.Preferences.Opaque" parent="App.Theme.Leanback.Preferences.Base">
        <!-- IllegalStateException: Only fullscreen opaque activities can request orientation -->
        <item name="android:windowIsTranslucent">false</item>
    </style>
