        <!-- Fix 'screen off' mode on some devices? -->
        <item tools:targetApi="18" name="android:windowOverscan">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Settings panel colors (see leanback_preference_fragment.xml) -->
