<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <attr name="brandColor" format="reference"/>
    <attr name="brandAccentColor" format="reference"/>
    <attr name="shelfBackground" format="reference"/>
    <attr name="cardDefaultBackground" format="reference"/>
    <attr name="cardSelectedBackground" format="reference"/>
    <attr name="cardProgressStyle" format="reference"/>
    <attr name="appLogo" format="reference"/>
    <attr name="cardFocusRing" format="reference"/>
    <attr name="topButtonColor" format="reference"/>
    <attr name="topButtonFocusColor" format="reference"/>
    <attr name="playerButtonColor" format="reference"/>
    <attr name="playerButtonFocusColor" format="reference"/>
    <attr name="playerButtonFocusIconColor" format="reference"/>
    <attr name="settingsPanelBackground" format="reference"/>
    <attr name="settingsPanelTitleBackground" format="reference"/>
    <attr name="settingsPanelPadding" format="reference|dimension"/>
    <attr name="settingsRowBackground" format="reference"/>
    <attr name="settingsRowTitleColor" format="reference"/>
    <attr name="settingsRowSummaryColor" format="reference"/>
    <attr name="settingsCheckButton" format="reference"/>
    <attr name="titleBarBackground" format="reference"/>
    <attr name="premiumTooltipFrame" format="reference"/>
    <attr name="premiumTooltipTextColor" format="reference"/>

    <!-- MOD: YouTube style font (Roboto) instead of the condensed leanback font -->
    <style name="TextAppearance.Leanback" parent="TextAppearance.LeanbackBase">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Increase spacing between items in GridView -->
    <style name="GridViewStyle" parent="Widget.Leanback.GridItems.VerticalGridView">
        <item name="android:horizontalSpacing">@dimen/grid_item_horizontal_spacing</item>
        <item name="android:verticalSpacing">@dimen/grid_item_vertical_spacing</item>
    </style>

    <!-- Increase spacing between items in RowView -->
    <style name="RowViewStyle" parent="Widget.Leanback.Row.HorizontalGridView">
        <item name="android:horizontalSpacing">@dimen/grid_item_horizontal_spacing</item>
    </style>

    <!-- Decrease header spacing in BrowseView -->
    <style name="BrowseHeaderStyle" parent="Widget.Leanback.Headers.VerticalGridView">
        <item name="android:verticalSpacing">@dimen/browse_headers_vertical_spacing</item>
        <!-- MOD: logo sits top left now, keep menu items from scrolling under it -->
        <item name="android:paddingTop">@dimen/browse_headers_padding_top</item>
        <item name="android:clipToPadding">true</item>
    </style>

    <!-- Color scheme: Teal (Default) -->
    <style name="App.Theme.Leanback.Player" parent="Theme.Leanback">
        <!-- <item name="android:windowBackground">@null</item> -->
        <!-- NOTE: don't use transparency because the BackgroundManager won't work (BackgroundManager:778) -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="shelfBackground">@color/shelf_background_dark</item>
        <item name="cardDefaultBackground">@color/card_default_background_dark</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white</item>
        <item name="cardProgressStyle">?android:attr/progressBarStyleHorizontal</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/fastlane_background</item>
        <item name="itemsVerticalGridStyle">@style/GridViewStyle</item>
        <item name="rowHorizontalGridStyle">@style/RowViewStyle</item>
        <!-- Disable activity transition animations -->
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Make activity fullscreen -->
        <item name="android:windowFullscreen">true</item>
        <!-- Overlay bottom bar (can't hide it from styles) -->
        <item tools:targetApi="19" name="android:windowTranslucentNavigation">true</item>
        <!-- Fix 'screen off' mode on some devices? -->
        <item tools:targetApi="18" name="android:windowOverscan">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Round player buttons (see drawable-v21/lb_control_button_*.xml) -->
        <item name="playerButtonColor">@color/youtube_button</item>
        <item name="playerButtonFocusColor">@color/youtube_button_focused</item>
        <!-- Settings panel colors (see leanback_preference_fragment.xml) -->
        <item name="settingsPanelBackground">@color/lb_preference_decor_list_background</item>
        <item name="settingsPanelTitleBackground">?attr/defaultBrandColor</item>
        <item name="settingsPanelPadding">0dp</item>
        <item name="settingsRowBackground">?android:attr/selectableItemBackground</item>
        <item name="settingsRowTitleColor">@color/lb_preference_item_primary_text_color</item>
        <item name="settingsRowSummaryColor">@color/lb_preference_item_secondary_text_color</item>
        <item name="settingsCheckButton">?android:attr/listChoiceIndicatorMultiple</item>
        <item name="titleBarBackground">@android:color/transparent</item>
        <item name="premiumTooltipFrame">@drawable/tooltip_frame_dark_mod</item>
        <item name="premiumTooltipTextColor">@color/foreground_material_dark_mod</item>
    </style>
    <style name="App.Theme.Leanback.Browse" parent="Theme.Leanback.Browse">
        <item name="android:windowBackground">@color/shelf_background_dark</item>
        <item name="brandColor">@color/fastlane_background_dark</item>
        <item name="brandAccentColor">@color/fastlane_background</item>
        <item name="shelfBackground">@color/shelf_background_dark</item>
        <item name="cardDefaultBackground">@color/card_default_background_dark</item>
