<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: round player buttons, colors come from the player theme -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/lb_control_button_color" >

    <item>
        <selector android:constantSize="true" >
            <item android:state_focused="true">
                <shape android:shape="oval" >
                    <solid android:color="?attr/playerButtonFocusColor" />
                    <size
                        android:height="@dimen/lb_control_button_secondary_diameter"
                        android:width="@dimen/lb_control_button_secondary_diameter" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval" >
                    <solid android:color="?attr/playerButtonColor" />
                    <size
                        android:height="@dimen/lb_control_button_secondary_diameter"
                        android:width="@dimen/lb_control_button_secondary_diameter" />
                </shape>
            </item>
        </selector>
    </item>

    <item android:id="@android:id/mask">
        <selector android:constantSize="true" >
            <item android:state_focused="true">
                <shape android:shape="oval" >
                    <!-- Color not used since this is a ripple mask -->
                    <solid android:color="#000000" />
                    <size
                        android:height="@dimen/lb_control_button_secondary_diameter"
                        android:width="@dimen/lb_control_button_secondary_diameter" />
                    <!-- fix clipped sides of the circle by adding transparent outline -->
                    <stroke
                        android:width="1dp"
                        android:color="#00FFFFFF"/>
                </shape>
            </item>
        </selector>
    </item>

</ripple>
